  "guides": [
    {
      "place": "Shanghai",
      "topic": "A city of crossings",
      "text": "Shanghai grew into a major port where Chinese, European and global influences met. The Bund’s historic riverfront faces Pudong’s modern skyline across the Huangpu.",
      "photo": "shanghai"
    },
    {
      "place": "Wuzhen · Hangzhou · Suzhou",
      "topic": "Water, gardens, scholarship",
      "text": "The Jiangnan region is shaped by canals, lakes and cultivated landscapes. Suzhou’s classical gardens compress mountains, water and architecture into contemplative spaces.",
      "photo": "wuzhen"
    },
    {
      "place": "Beijing",
      "topic": "The imperial centre",
      "text": "For centuries Beijing was the seat of dynasties. The Forbidden City, its gates and ceremonial axes reflect the order and scale of imperial rule.",
      "photo": "beijing"
    },
    {
      "place": "Hong Kong · Macau",
      "topic": "Two port histories",
      "text": "Both cities grew through maritime trade and layered colonial histories. Their food, architecture and everyday rhythms carry Cantonese roots alongside global influences.",
      "photo": "hong-kong"
    },
    {
      "place": "Shenzhen · Guangzhou",
      "topic": "The Pearl River Delta",
      "text": "The delta has long connected inland China to the sea. Today it is one of the world’s most dynamic urban regions, with deep Cantonese food and cultural traditions.",
      "photo": "shenzhen"
    },
    {
      "place": "At the table",
      "topic": "Taste the region",
      "text": "Look for Shanghai soup dumplings, Hangzhou tea and lake fish, Suzhou noodles, Beijing roast duck and Cantonese dim sum. Ask about allergens and local specialties.",
      "photo": "cuisine"
    }
  ],
